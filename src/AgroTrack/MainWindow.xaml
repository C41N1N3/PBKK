<Window x:Class="AgroTrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AgroTrack.ViewModels"
        xmlns:views="clr-namespace:AgroTrack.Views"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="760" Width="1200" MinHeight="650" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <!-- DataTemplates for ViewModels -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LandViewModel}">
            <views:LandView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CommodityViewModel}">
            <views:CommodityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlantingViewModel}">
            <views:PlantingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
            <views:ActivityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaterialViewModel}">
            <views:MaterialView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CostViewModel}">
            <views:CostView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HarvestViewModel}">
            <views:HarvestView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserManagementViewModel}">
            <views:UserManagementView />
        </DataTemplate>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8F0EA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="8,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2E5C38" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- WHEN NOT AUTHENTICATED: Display Login Directly -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisConverter}}">
            <ContentControl Content="{Binding CurrentContentViewModel}" />
        </Grid>

        <!-- WHEN AUTHENTICATED: Display Full Application Shell (Sidebar + Header + Body) -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 1. LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header / Brand -->
                    <Border Grid.Row="0" Padding="18,20,18,16" BorderThickness="0,0,0,1" BorderBrush="#2A4A32">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="42" Height="42" CornerRadius="10" Background="#3A7D44"
                                    Margin="0,0,12,0">
                                <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Batang -->
                                    <Rectangle Canvas.Left="10.5" Canvas.Top="6" Width="3" Height="14"
                                               Fill="#A8E6B0" RadiusX="1.5" RadiusY="1.5"/>
                                    <!-- Butir kiri atas -->
                                    <Ellipse Canvas.Left="3" Canvas.Top="6" Width="8" Height="5" Fill="#C8F0C8">
                                        <Ellipse.RenderTransform><RotateTransform Angle="-30" CenterX="7" CenterY="8"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <!-- Butir kanan atas -->
                                    <Ellipse Canvas.Left="13" Canvas.Top="6" Width="8" Height="5" Fill="#C8F0C8">
                                        <Ellipse.RenderTransform><RotateTransform Angle="30" CenterX="17" CenterY="8"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <!-- Butir kiri bawah -->
                                    <Ellipse Canvas.Left="2" Canvas.Top="11" Width="8" Height="5" Fill="#A8E6B0">
                                        <Ellipse.RenderTransform><RotateTransform Angle="-25" CenterX="6" CenterY="13"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <!-- Butir kanan bawah -->
                                    <Ellipse Canvas.Left="14" Canvas.Top="11" Width="8" Height="5" Fill="#A8E6B0">
                                        <Ellipse.RenderTransform><RotateTransform Angle="25" CenterX="18" CenterY="13"/></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <!-- Pucuk -->
                                    <Ellipse Canvas.Left="9" Canvas.Top="2" Width="6" Height="5" Fill="#D4F5D4"/>
                                    <!-- Tanah -->
                                    <Rectangle Canvas.Left="2" Canvas.Top="20" Width="20" Height="3"
                                               Fill="#7DB887" RadiusX="1.5" RadiusY="1.5"/>
                                </Canvas>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="AgroTrack" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="Manajemen Pertanian" FontSize="10.5" Foreground="#90B899" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Sidebar Navigation Menus -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10">
                        <StackPanel>
                            <!-- Section: Operasional Utama -->
                            <TextBlock Text="OPERASIONAL" FontSize="10" FontWeight="Bold" Foreground="#6FA87A"
                                       Margin="22,10,20,6" />

                            <Button Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" Margin="0,0,12,0">
                                        <TextBlock Text="▦" FontSize="13" Foreground="#E8F0EA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Dashboard" VerticalAlignment="Center" Foreground="#E8F0EA" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Lands">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" Margin="0,0,12,0">
                                        <TextBlock Text="◫" FontSize="13" Foreground="#E8F0EA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Lahan Pertanian" VerticalAlignment="Center" Foreground="#E8F0EA" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Commodities">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" Margin="0,0,12,0">
                                        <TextBlock Text="❖" FontSize="11" Foreground="#E8F0EA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Komoditas" VerticalAlignment="Center" Foreground="#E8F0EA" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Plantings">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" Margin="0,0,12,0">
                                        <TextBlock Text="▤" FontSize="13" Foreground="#E8F0EA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Musim Tanam" VerticalAlignment="Center" Foreground="#E8F0EA" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Activities">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" Margin="0,0,12,0">
                                        <TextBlock Text="►" FontSize="11" Foreground="#E8F0EA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Aktivitas Lapangan" VerticalAlignment="Center" Foreground="#E8F0EA" />
                                </StackPanel>
                            </Button>

                            <!-- Section: Logistik & Hasil -->
                            <TextBlock Text="LOGISTIK &amp; KEUANGAN" FontSize="10" FontWeight="Bold" Foreground="#6FA87A"
                                       Margin="22,16,20,6" />

                            <Button Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Materials">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" Margin="0,0,12,0">
                                        <TextBlock Text="▣" FontSize="13" Foreground="#E8F0EA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Bahan &amp; Stok" VerticalAlignment="Center" Foreground="#E8F0EA" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Costs"
                                    Visibility="{Binding CanViewCosts, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" Margin="0,0,12,0">
                                        <TextBlock Text="◈" FontSize="13" Foreground="#E8F0EA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Biaya Operasional" VerticalAlignment="Center" Foreground="#E8F0EA" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Harvests">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" Margin="0,0,12,0">
                                        <TextBlock Text="◉" FontSize="13" Foreground="#E8F0EA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Hasil Panen" VerticalAlignment="Center" Foreground="#E8F0EA" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Reports"
                                    Visibility="{Binding CanViewReports, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" Margin="0,0,12,0">
                                        <TextBlock Text="▲" FontSize="11" Foreground="#E8F0EA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Laporan Produksi" VerticalAlignment="Center" Foreground="#E8F0EA" />
                                </StackPanel>
                            </Button>

                            <!-- Section: Administrasi -->
                            <TextBlock Text="PENGATURAN" FontSize="10" FontWeight="Bold" Foreground="#6FA87A"
                                       Margin="22,16,20,6"
                                       Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVisConverter}}" />

                            <Button Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Users"
                                    Visibility="{Binding CanManageUsers, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" Margin="0,0,12,0">
                                        <TextBlock Text="◎" FontSize="13" Foreground="#E8F0EA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Manajemen Pengguna" VerticalAlignment="Center" Foreground="#E8F0EA" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sidebar Footer / Active User Card -->
                    <Border Grid.Row="2" Background="#111F16" Padding="16,12" BorderThickness="0,1,0,0" BorderBrush="#2A4A32">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="17" Background="#2E5C38"
                                    Margin="0,0,10,0">
                                <TextBlock Text="U" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.FullName}" Foreground="#FFFFFF"
                                           FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding CurrentUser.RoleDisplayName}" Foreground="#7DB887"
                                           FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. MAIN CONTENT AREA (Header + Body) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Header Bar -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="24,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Page Title Breadcrumb -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="AgroTrack" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="  /  " FontSize="13" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="{Binding CurrentContentViewModel.Title}" FontSize="15"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Header Actions (Theme Toggle & Logout) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Theme Toggle Button -->
                            <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,12,0" Padding="12,6">
                                <TextBlock Text="{Binding CurrentThemeDisplay}" FontSize="12" />
                            </Button>

                            <!-- Logout Button -->
                            <Button Command="{Binding LogoutCommand}" Style="{StaticResource DangerButton}"
                                    Padding="14,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚪 " FontSize="12" />
                                    <TextBlock Text="Keluar" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dynamic Content Host -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentContentViewModel}" Margin="20" />
            </Grid>
        </Grid>
    </Grid>
</Window>
