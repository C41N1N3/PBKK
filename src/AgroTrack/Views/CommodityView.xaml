<UserControl x:Class="AgroTrack.Views.CommodityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid>
        <!-- MAIN CONTENT LAYER -->
        <Grid Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Manajemen Komoditas Pertanian" Style="{StaticResource Heading2}" />
                    <TextBlock Text="Daftar varietas tanaman, satuan hasil panen, dan estimasi siklus masa tanam."
                               Style="{StaticResource Subtext}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="+ Tambah Komoditas" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenAddFormCommand}"
                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVisConverter}}" />
            </Grid>

            <!-- 1. Filters & Search Bar -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" VerticalContentAlignment="Center" Margin="0,0,12,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Status Filter -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Status:" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Subtext}" />
                        <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}"
                                  Width="130" Height="36" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Reset Filter Button -->
                    <Button Grid.Column="2" Content="Reset Filter" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetFilterCommand}" Height="36" />
                </Grid>
            </Border>

            <!-- 2. Loading & Error Banners -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <!-- Loading State Indicator -->
                <Border Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="⏳ Memuat data komoditas..." FontWeight="Medium" Foreground="{DynamicResource PrimaryDarkBrush}" />
                </Border>

                <!-- Error State Banner -->
                <Border Background="#FFEBEE" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                                   FontWeight="Medium" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Coba Lagi" Style="{StaticResource SecondaryButton}"
                                Command="{Binding LoadCommoditiesCommand}" Padding="8,4" FontSize="11" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 3. DataGrid & Empty State -->
            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding Commodities}" AutoGenerateColumns="False" IsReadOnly="True"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kode" Binding="{Binding CommodityCode}" Width="100" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Nama Komoditas" Binding="{Binding CommodityName}" Width="180" FontWeight="Medium" />
                        <DataGridTextColumn Header="Satuan Hasil" Binding="{Binding ResultUnit}" Width="110" />
                        <DataGridTextColumn Header="Estimasi Tumbuh" Binding="{Binding GrowthDaysDisplay}" Width="140" />
                        <DataGridTemplateColumn Header="Penanaman Terkait" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="10"
                                            Padding="8,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding TotalPlantingsCount, StringFormat='{}{0} Musim'}"
                                                   Foreground="{DynamicResource PrimaryDarkBrush}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Keterangan" Binding="{Binding Description}" Width="*" />
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                            Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Medium" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Aksi" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Ubah" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11"
                                                Margin="0,0,4,0"
                                                Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}" />
                                        <Button Content="Toggle" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11"
                                                Margin="0,0,4,0"
                                                Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}" />
                                        <Button Content="Hapus" Style="{StaticResource DangerButton}" Padding="6,2" FontSize="11"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Container -->
                <Border Style="{StaticResource CardPanel}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisConverter}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40" MaxWidth="450">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🌱" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Tidak Ada Data Komoditas" Style="{StaticResource Heading3}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Data komoditas pertanian belum tersedia atau tidak cocok dengan filter pencarian."
                                   Style="{StaticResource Subtext}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <Button Content="Reset Filter &amp; Muat Ulang" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ResetFilterCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Pagination Bar -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PaginationDisplay}" VerticalAlignment="Center" Style="{StaticResource Subtext}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="◀ Sebelumnya" Style="{StaticResource SecondaryButton}"
                            Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" Padding="12,5" FontSize="12" />
                    <Button Content="Berikutnya ▶" Style="{StaticResource SecondaryButton}"
                            Command="{Binding NextPageCommand}" Padding="12,5" FontSize="12" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- MODAL FORM DIALOG OVERLAY (TAMBAH / UBAH KOMODITAS) -->
        <Grid Background="#80000000"
              Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="480" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Effect="{DynamicResource DialogDropShadow}">
                <Border.Resources>
                    <DropShadowEffect x:Key="DialogDropShadow" BlurRadius="24" Direction="270" Opacity="0.15" ShadowDepth="4" />
                </Border.Resources>

                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Heading2}" Margin="0,0,0,16" />

                    <!-- Form Validation Error Banner -->
                    <Border Background="#FFEBEE" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,6" Margin="0,0,0,14"
                            Visibility="{Binding FormValidationError, Converter={StaticResource NullToVisConverter}}">
                        <TextBlock Text="{Binding FormValidationError}" Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12" TextWrapping="Wrap" FontWeight="Medium" />
                    </Border>

                    <!-- Form Grid -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: Kode & Nama -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Kode Komoditas *" Style="{StaticResource Subtext}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormCommodityCode, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Nama Komoditas *" Style="{StaticResource Subtext}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormCommodityName, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <!-- Row 1: Satuan & Hari Tumbuh -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Satuan Hasil Panen *" Style="{StaticResource Subtext}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding FormResultUnit}"
                                      Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Estimasi Hari Tumbuh *" Style="{StaticResource Subtext}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormEstimatedGrowthDays, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <!-- Row 2: Deskripsi -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,12">
                            <TextBlock Text="Deskripsi &amp; Karakteristik Varietas" Style="{StaticResource Subtext}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Height="55" TextWrapping="Wrap" AcceptsReturn="True" />
                        </StackPanel>

                        <!-- Row 3: Status Aktif -->
                        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,14">
                            <CheckBox IsChecked="{Binding FormIsActive}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Komoditas Aktif (Dapat dipilih dalam musim tanam baru)"
                                       VerticalAlignment="Center" Style="{StaticResource Subtext}" />
                        </StackPanel>
                    </Grid>

                    <!-- Form Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Batal" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelFormCommand}" Margin="0,0,10,0" Padding="16,7" />
                        <Button Content="Simpan Data" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}" Padding="20,7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
