<UserControl x:Class="AgroTrack.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:AgroTrack.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ActivityViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100">

    <Grid Margin="24">
        <!-- Main Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Page Header -->
                <RowDefinition Height="Auto"/> <!-- Search & Filter Panel -->
                <RowDefinition Height="*"/>    <!-- DataGrid & States -->
                <RowDefinition Height="Auto"/> <!-- Pagination Toolbar -->
            </Grid.RowDefinitions>

            <!-- 1. Page Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Aktivitas Lapangan &amp; Budidaya" 
                               FontSize="24" FontWeight="Bold" 
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text="Catat, pantau tahapan pekerjaan harian, dan pantau status pelaksanaan aktivitas pertanian." 
                               FontSize="13" Margin="0,4,0,0"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>

                <Button Grid.Column="1" 
                        Style="{DynamicResource PrimaryButton}"
                        Command="{Binding OpenCreateFormCommand}"
                        Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" FontWeight="Bold" Margin="0,0,8,0" FontSize="14"/>
                        <TextBlock Text="Tambah Aktivitas" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 2. Search & Filter Bar -->
            <Border Grid.Row="1" 
                    Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,8">
                        <TextBlock Text="Pencarian" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{DynamicResource InputTextBox}"
                                 Tag="Cari deskripsi, kode penanaman, atau petugas..."/>
                    </StackPanel>

                    <!-- Planting Filter -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,8">
                        <TextBlock Text="Penanaman" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Plantings}"
                                  SelectedValue="{Binding SelectedPlantingId}"
                                  SelectedValuePath="PlantingId"
                                  DisplayMemberPath="PlantingCode"
                                  Style="{DynamicResource ModernComboBox}"/>
                    </StackPanel>

                    <!-- Activity Type Filter -->
                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,12,8">
                        <TextBlock Text="Jenis Aktivitas" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ActivityTypes}"
                                  SelectedItem="{Binding SelectedTypeFilter}"
                                  Style="{DynamicResource ModernComboBox}"/>
                    </StackPanel>

                    <!-- Status Filter -->
                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,12,8">
                        <TextBlock Text="Status" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding ActivityStatuses}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Style="{DynamicResource ModernComboBox}"/>
                    </StackPanel>

                    <!-- Filter Action Buttons -->
                    <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Button Style="{DynamicResource SecondaryButton}" 
                                Command="{Binding SearchCommand}"
                                ToolTip="Terapkan Filter"
                                Padding="12,8" Margin="0,0,8,0">
                            <TextBlock Text="🔍 Filter" FontWeight="SemiBold"/>
                        </Button>
                        <Button Style="{DynamicResource SecondaryButton}" 
                                Command="{Binding ResetFilterCommand}"
                                ToolTip="Reset Filter"
                                Padding="12,8">
                            <TextBlock Text="↺ Reset" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Main DataGrid & States -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <!-- Loading State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,0,0,12"/>
                        <TextBlock Text="Memuat data aktivitas pertanian..." 
                                   Foreground="{DynamicResource BrushTextSecondary}" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="Belum ada aktivitas pertanian yang ditemukan" 
                                   FontSize="16" FontWeight="SemiBold" 
                                   Foreground="{DynamicResource BrushTextPrimary}" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Klik tombol 'Tambah Aktivitas' untuk mencatat kegiatan lapangan baru." 
                                   FontSize="13" Margin="0,6,0,0"
                                   Foreground="{DynamicResource BrushTextSecondary}" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- DataGrid -->
                    <DataGrid ItemsSource="{Binding Activities}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              RowHeight="44"
                              SelectionMode="Single"
                              BorderThickness="0"
                              Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <!-- Tanggal -->
                            <DataGridTextColumn Header="Tanggal" 
                                                Binding="{Binding ActivityDateDisplay}" 
                                                Width="110"/>

                            <!-- Kode Penanaman -->
                            <DataGridTemplateColumn Header="Penanaman" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PlantingCode}" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource BrushPrimary}"/>
                                            <TextBlock Text="{Binding SeasonName}" FontSize="11" 
                                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Lahan & Komoditas -->
                            <DataGridTemplateColumn Header="Lahan &amp; Komoditas" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CommodityName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding LandName}" FontSize="11" 
                                                       Foreground="{DynamicResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Jenis Aktivitas -->
                            <DataGridTextColumn Header="Jenis Pekerjaan" 
                                                Binding="{Binding ActivityTypeDisplay}" 
                                                Width="130"/>

                            <!-- Deskripsi Ringkas -->
                            <DataGridTextColumn Header="Uraian Aktivitas" 
                                                Binding="{Binding Description}" 
                                                Width="*"/>

                            <!-- Durasi -->
                            <DataGridTextColumn Header="Durasi" 
                                                Binding="{Binding DurationDisplay}" 
                                                Width="90"/>

                            <!-- Petugas -->
                            <DataGridTextColumn Header="Pelaksana" 
                                                Binding="{Binding OfficerName}" 
                                                Width="130"/>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"
                                                Background="{DynamicResource BrushCardBackground}"
                                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource BrushPrimary}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Aksi -->
                            <DataGridTemplateColumn Header="Aksi" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{DynamicResource SecondaryButton}"
                                                    Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,4" Margin="0,0,6,0"
                                                    ToolTip="Ubah Aktivitas">
                                                <TextBlock Text="✏️" FontSize="11"/>
                                            </Button>
                                            <Button Style="{DynamicResource DangerButton}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="8,4"
                                                    ToolTip="Hapus Aktivitas">
                                                <TextBlock Text="🗑️" FontSize="11"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 4. Pagination Toolbar -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Menampilkan " Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding Activities.Count}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text=" dari total " Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding TotalItems}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text=" aktivitas (Halaman " Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding CurrentPage}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text=" dari " Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding TotalPages}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock Text=")" Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{DynamicResource SecondaryButton}"
                            Command="{Binding PreviousPageCommand}"
                            Padding="12,6" Margin="0,0,8,0">
                        <TextBlock Text="◀ Sebelumnya"/>
                    </Button>
                    <Button Style="{DynamicResource SecondaryButton}"
                            Command="{Binding NextPageCommand}"
                            Padding="12,6">
                        <TextBlock Text="Berikutnya ▶"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 5. Form Modal Dialog (Overlay) -->
        <Grid Visibility="{Binding IsFormOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Background Backdrop -->
            <Border Background="#80000000"/>

            <!-- Dialog Window -->
            <Border Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Width="540"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="28"
                    Effect="{DynamicResource ShadowMedium}">
                <StackPanel>
                    <!-- Dialog Header -->
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="{Binding FormTitle}" 
                                   FontSize="18" FontWeight="Bold" 
                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                        <Button Style="{DynamicResource SecondaryButton}"
                                Command="{Binding CancelFormCommand}"
                                HorizontalAlignment="Right"
                                Padding="8,2" Content="✕"/>
                    </Grid>

                    <!-- Form Controls -->
                    <!-- 1. Penanaman -->
                    <TextBlock Text="Penanaman Terkait *" FontSize="12" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Plantings}"
                              SelectedValue="{Binding FormPlantingId}"
                              SelectedValuePath="PlantingId"
                              DisplayMemberPath="PlantingCode"
                              Style="{DynamicResource ModernComboBox}"
                              Margin="0,0,0,12"/>

                    <!-- 2. Jenis Aktivitas -->
                    <TextBlock Text="Jenis Pekerjaan *" FontSize="12" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ActivityTypes}"
                              SelectedItem="{Binding FormActivityType}"
                              Style="{DynamicResource ModernComboBox}"
                              Margin="0,0,0,12"/>

                    <!-- 3. Tanggal & Durasi -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tanggal Pelaksanaan *" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <DatePicker SelectedDate="{Binding FormActivityDate}"
                                        Style="{DynamicResource ModernDatePicker}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Durasi (Jam)" FontSize="12" FontWeight="SemiBold" 
                                       Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding FormDurationHours, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{DynamicResource InputTextBox}"
                                     Tag="Contoh: 3.5"/>
                        </StackPanel>
                    </Grid>

                    <!-- 4. Status Pelaksanaan -->
                    <TextBlock Text="Status Pelaksanaan *" FontSize="12" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding ActivityStatuses}"
                              SelectedItem="{Binding FormStatus}"
                              Style="{DynamicResource ModernComboBox}"
                              Margin="0,0,0,12"/>

                    <!-- 5. Uraian Deskripsi -->
                    <TextBlock Text="Uraian Aktivitas *" FontSize="12" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource InputTextBox}"
                             AcceptsReturn="True"
                             Height="80"
                             TextWrapping="Wrap"
                             Tag="Tuliskan catatan pelaksanaan aktivitas lapangan..."
                             Margin="0,0,0,24"/>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{DynamicResource SecondaryButton}"
                                Command="{Binding CancelFormCommand}"
                                Content="Batal"
                                Padding="16,8" Margin="0,0,10,0"/>
                        <Button Style="{DynamicResource PrimaryButton}"
                                Command="{Binding SaveFormCommand}"
                                Content="Simpan Aktivitas"
                                Padding="20,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
