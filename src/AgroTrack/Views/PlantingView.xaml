<UserControl x:Class="AgroTrack.Views.PlantingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <Grid>
        <!-- MAIN CONTENT LAYER -->
        <Grid Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Manajemen Musim Tanam &amp; Penanaman" Style="{StaticResource Heading2}" />
                    <TextBlock Text="Kelola siklus budidaya pertanian dari perencanaan, pemeliharaan, hingga realisasi hasil panen."
                               Style="{StaticResource Subtext}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="+ Musim Tanam Baru" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenAddFormCommand}"
                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVisConverter}}" />
            </Grid>

            <!-- 1. Filters & Search Bar -->
            <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" VerticalContentAlignment="Center" Margin="0,0,12,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Status Filter -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Status:" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Subtext}" />
                        <ComboBox ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}"
                                  Width="130" Height="36" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Land Filter -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Lahan:" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Subtext}" />
                        <ComboBox ItemsSource="{Binding AvailableLands}" SelectedItem="{Binding SelectedLandFilter}"
                                  DisplayMemberPath="LandName" Width="140" Height="36" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Commodity Filter -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Komoditas:" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource Subtext}" />
                        <ComboBox ItemsSource="{Binding AvailableCommodities}" SelectedItem="{Binding SelectedCommodityFilter}"
                                  DisplayMemberPath="CommodityName" Width="140" Height="36" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- Reset Filter Button -->
                    <Button Grid.Column="4" Content="Reset" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ResetFilterCommand}" Height="36" />
                </Grid>
            </Border>

            <!-- 2. Loading & Error Banners -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <Border Background="{DynamicResource PrimaryLightBrush}" BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="⏳ Memuat data musim tanam dan kalkulasi produksi..." FontWeight="Medium" Foreground="{DynamicResource PrimaryDarkBrush}" />
                </Border>

                <Border Background="#FFEBEE" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                                   FontWeight="Medium" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Coba Lagi" Style="{StaticResource SecondaryButton}"
                                Command="{Binding LoadPlantingsCommand}" Padding="8,4" FontSize="11" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 3. DataGrid & Empty State -->
            <Grid Grid.Row="3">
                <DataGrid ItemsSource="{Binding Plantings}" AutoGenerateColumns="False" IsReadOnly="True"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Kode" Binding="{Binding PlantingCode}" Width="110" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Nama Musim" Binding="{Binding SeasonName}" Width="160" FontWeight="Medium" />
                        <DataGridTextColumn Header="Lahan" Binding="{Binding LandName}" Width="130" />
                        <DataGridTextColumn Header="Komoditas" Binding="{Binding CommodityName}" Width="130" />
                        <DataGridTextColumn Header="Luas Tanam" Binding="{Binding PlantedAreaDisplay}" Width="100" />
                        <DataGridTextColumn Header="Periode" Binding="{Binding PeriodDisplay}" Width="190" />
                        <DataGridTemplateColumn Header="Realisasi / Target" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12">
                                            <Run Text="{Binding TotalActualYield, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" />
                                            <Run Text=" / " Foreground="{DynamicResource TextMutedBrush}" />
                                            <Run Text="{Binding TargetYield, StringFormat='{}{0:N0}'}" />
                                            <Run Text="{Binding ResultUnit}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding TargetAchievementPercentage, Converter={StaticResource PercentageConverter}, StringFormat='Capaian: {0}'}"
                                                   FontSize="11" Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="Medium" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                                            Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Medium" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Aksi" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Detail" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11"
                                                Margin="0,0,4,0"
                                                Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Ubah" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="11"
                                                Margin="0,0,4,0"
                                                Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}" />
                                        <Button Content="Hapus" Style="{StaticResource DangerButton}" Padding="6,2" FontSize="11"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanManage, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisConverter}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty State Container -->
                <Border Style="{StaticResource CardPanel}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisConverter}}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40" MaxWidth="450">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📅" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="Tidak Ada Data Penanaman" Style="{StaticResource Heading3}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Belum ada musim tanam yang terdaftar atau sesuai kriteria filter saat ini."
                                   Style="{StaticResource Subtext}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <Button Content="Reset Filter &amp; Muat Ulang" Style="{StaticResource SecondaryButton}"
                                Command="{Binding ResetFilterCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Pagination Bar -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding PaginationDisplay}" VerticalAlignment="Center" Style="{StaticResource Subtext}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="◀ Sebelumnya" Style="{StaticResource SecondaryButton}"
                            Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" Padding="12,5" FontSize="12" />
                    <Button Content="Berikutnya ▶" Style="{StaticResource SecondaryButton}"
                            Command="{Binding NextPageCommand}" Padding="12,5" FontSize="12" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- DETAIL DRAWER MODAL OVERLAY -->
        <Grid Background="#80000000"
              Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="650" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Effect="{DynamicResource DialogDropShadow}">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedPlanting.SeasonName}" Style="{StaticResource Heading2}" />
                            <TextBlock Text="{Binding SelectedPlanting.PlantingCode, StringFormat='Kode: {0}'}" Style="{StaticResource Subtext}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕ Tutup" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CloseDetailCommand}" Padding="10,4" />
                    </Grid>

                    <!-- Financial & Yield Summary Cards -->
                    <UniformGrid Columns="3" Margin="0,0,0,16">
                        <!-- Card 1: Target vs Actual -->
                        <Border Style="{StaticResource CardPanel}" Margin="4" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Target vs Realisasi" Style="{StaticResource Subtext}" />
                                <TextBlock FontSize="16" FontWeight="Bold" Margin="0,4,0,0">
                                    <Run Text="{Binding SelectedPlanting.TotalActualYield, StringFormat='{}{0:N0}'}" Foreground="{DynamicResource PrimaryBrush}" />
                                    <Run Text="/" Foreground="{DynamicResource TextMutedBrush}" />
                                    <Run Text="{Binding SelectedPlanting.TargetYield, StringFormat='{}{0:N0}'}" />
                                </TextBlock>
                                <TextBlock Text="{Binding SelectedPlanting.TargetAchievementPercentage, Converter={StaticResource PercentageConverter}, StringFormat='Capaian: {0}'}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryDarkBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Total Biaya -->
                        <Border Style="{StaticResource CardPanel}" Margin="4" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Total Pengeluaran" Style="{StaticResource Subtext}" />
                                <TextBlock Text="{Binding SelectedPlanting.TotalCost, Converter={StaticResource CurrencyConverter}}"
                                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding SelectedPlanting.TotalOperationalCost, Converter={StaticResource CurrencyConverter}, StringFormat='Ops: {0}'}"
                                           FontSize="10" Style="{StaticResource Subtext}" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Keuntungan Bersih -->
                        <Border Style="{StaticResource CardPanel}" Margin="4" Padding="12">
                            <StackPanel>
                                <TextBlock Text="Laba Bersih" Style="{StaticResource Subtext}" />
                                <TextBlock Text="{Binding SelectedPlanting.NetProfit, Converter={StaticResource CurrencyConverter}}"
                                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding SelectedPlanting.TotalRevenue, Converter={StaticResource CurrencyConverter}, StringFormat='Omset: {0}'}"
                                           FontSize="10" Style="{StaticResource Subtext}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Information Grid -->
                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="Lahan:" Style="{StaticResource Subtext}" />
                                <TextBlock Text="{Binding SelectedPlanting.LandName}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                <TextBlock Text="Komoditas:" Style="{StaticResource Subtext}" />
                                <TextBlock Text="{Binding SelectedPlanting.CommodityName}" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                <TextBlock Text="Luas Tanam:" Style="{StaticResource Subtext}" />
                                <TextBlock Text="{Binding SelectedPlanting.PlantedAreaDisplay}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                <TextBlock Text="Status Saat Ini:" Style="{StaticResource Subtext}" />
                                <TextBlock Text="{Binding SelectedPlanting.StatusDisplay}" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                <TextBlock Text="Catatan:" Style="{StaticResource Subtext}" />
                                <TextBlock Text="{Binding SelectedPlanting.Notes}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Quick Status Transition Toolbar -->
                    <TextBlock Text="Ubah Status Musim Tanam:" Style="{StaticResource Subtext}" Margin="0,0,0,8"
                               Visibility="{Binding CanManage, Converter={StaticResource BoolToVisConverter}}" />
                    <UniformGrid Columns="4" Margin="0,0,0,8"
                                 Visibility="{Binding CanManage, Converter={StaticResource BoolToVisConverter}}">
                        <Button Content="▶ Aktifkan" Style="{StaticResource SecondaryButton}" Margin="2,0"
                                Command="{Binding ChangeStatusCommand}" CommandParameter="{x:Static enums:PlantingStatus.Active}"
                                xmlns:enums="clr-namespace:AgroTrack.Enums" />
                        <Button Content="🌾 Siap Panen" Style="{StaticResource SecondaryButton}" Margin="2,0"
                                Command="{Binding ChangeStatusCommand}" CommandParameter="{x:Static enums:PlantingStatus.ReadyToHarvest}"
                                xmlns:enums="clr-namespace:AgroTrack.Enums" />
                        <Button Content="✅ Selesai" Style="{StaticResource PrimaryButton}" Margin="2,0"
                                Command="{Binding ChangeStatusCommand}" CommandParameter="{x:Static enums:PlantingStatus.Completed}"
                                xmlns:enums="clr-namespace:AgroTrack.Enums" />
                        <Button Content="⛔ Batalkan" Style="{StaticResource DangerButton}" Margin="2,0"
                                Command="{Binding ChangeStatusCommand}" CommandParameter="{x:Static enums:PlantingStatus.Cancelled}"
                                xmlns:enums="clr-namespace:AgroTrack.Enums" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MODAL FORM DIALOG OVERLAY (TAMBAH / UBAH MUSIM TANAM) -->
        <Grid Background="#80000000"
              Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="560" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Effect="{DynamicResource DialogDropShadow}">
                <StackPanel>
                    <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Heading2}" Margin="0,0,0,16" />

                    <!-- Form Validation Error Banner -->
                    <Border Background="#FFEBEE" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10,6" Margin="0,0,0,14"
                            Visibility="{Binding FormValidationError, Converter={StaticResource NullToVisConverter}}">
                        <TextBlock Text="{Binding FormValidationError}" Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12" TextWrapping="Wrap" FontWeight="Medium" />
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: Kode & Nama Musim -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Kode Penanaman *" Style="{StaticResource Subtext}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormPlantingCode, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Nama Musim Tanam *" Style="{StaticResource Subtext}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormSeasonName, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <!-- Row 1: Lahan & Komoditas -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Lahan Pertanian *" Style="{StaticResource Subtext}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableLands}" SelectedItem="{Binding FormSelectedLand}"
                                      DisplayMemberPath="LandName" Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Komoditas *" Style="{StaticResource Subtext}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableCommodities}" SelectedItem="{Binding FormSelectedCommodity}"
                                      DisplayMemberPath="CommodityName" Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <!-- Row 2: Tanggal Mulai & Target Panen -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Tanggal Mulai Tanam *" Style="{StaticResource Subtext}" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding FormStartDate}" Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Target Tanggal Panen *" Style="{StaticResource Subtext}" Margin="0,0,0,4" />
                            <DatePicker SelectedDate="{Binding FormExpectedHarvestDate}" Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <!-- Row 3: Luas Tanam & Target Hasil -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="Luas Tanam (Hektare) *" Style="{StaticResource Subtext}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormPlantedAreaHectares, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}"
                                     Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="Target Hasil Panen (Satuan Komoditas) *" Style="{StaticResource Subtext}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormTargetYield, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N0}'}"
                                     Height="34" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <!-- Row 4: Catatan -->
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,0,0,16">
                            <TextBlock Text="Catatan &amp; Rencana Kerja" Style="{StaticResource Subtext}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Height="55" TextWrapping="Wrap" AcceptsReturn="True" />
                        </StackPanel>
                    </Grid>

                    <!-- Form Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Batal" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelFormCommand}" Margin="0,0,10,0" Padding="16,7" />
                        <Button Content="Simpan Data Musim" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}" Padding="20,7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
