<UserControl x:Class="AgroTrack.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:AgroTrack.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ReportViewModel}"
             d:DesignHeight="850" d:DesignWidth="1200">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. Page Header -->
            <RowDefinition Height="Auto"/> <!-- 1. Filter Panel -->
            <RowDefinition Height="Auto"/> <!-- 2. Summary KPI Cards -->
            <RowDefinition Height="*"/>    <!-- 3. Report DataGrid & States -->
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Laporan Produksi &amp; Analisis Keuntungan" 
                           FontSize="24" FontWeight="Bold" 
                           Foreground="{DynamicResource BrushTextPrimary}"/>
                <TextBlock Text="Evaluasi perbandingan target panen, biaya bahan, biaya operasional, pendapatan, dan laba/rugi per musim tanam." 
                           FontSize="13" Margin="0,4,0,0"
                           Foreground="{DynamicResource BrushTextSecondary}"/>
            </StackPanel>
        </Grid>

        <!-- 1. Filter Panel -->
        <Border Grid.Row="1" 
                Background="{DynamicResource BrushCardBackground}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Tanggal Mulai Dari -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Mulai Dari" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding StartDateFrom}"
                                Style="{DynamicResource ModernDatePicker}"/>
                </StackPanel>

                <!-- Tanggal Mulai Sampai -->
                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Sampai Tanggal" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding StartDateTo}"
                                Style="{DynamicResource ModernDatePicker}"/>
                </StackPanel>

                <!-- Filter Lahan -->
                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Lahan Pertanian" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Lands}"
                              SelectedValue="{Binding SelectedLandId}"
                              SelectedValuePath="LandId"
                              DisplayMemberPath="LandName"
                              Style="{DynamicResource ModernComboBox}"/>
                </StackPanel>

                <!-- Filter Komoditas -->
                <StackPanel Grid.Column="3" Margin="0,0,10,0">
                    <TextBlock Text="Komoditas" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Commodities}"
                              SelectedValue="{Binding SelectedCommodityId}"
                              SelectedValuePath="CommodityId"
                              DisplayMemberPath="CommodityName"
                              Style="{DynamicResource ModernComboBox}"/>
                </StackPanel>

                <!-- Filter Status -->
                <StackPanel Grid.Column="4" Margin="0,0,10,0">
                    <TextBlock Text="Status Penanaman" FontSize="11" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding PlantingStatuses}"
                              SelectedItem="{Binding SelectedStatus}"
                              Style="{DynamicResource ModernComboBox}"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{DynamicResource PrimaryButton}" 
                            Command="{Binding FilterCommand}"
                            Padding="14,8" Margin="0,0,8,0">
                        <TextBlock Text="🔍 Filter" FontWeight="SemiBold"/>
                    </Button>
                    <Button Style="{DynamicResource SecondaryButton}" 
                            Command="{Binding ResetFilterCommand}"
                            Padding="12,8">
                        <TextBlock Text="↺ Reset" FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. KPI Summary Cards Banner -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Target Hasil -->
            <Border Grid.Column="0" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="TARGET HASIL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding TotalTargetYieldDisplay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Realisasi Hasil -->
            <Border Grid.Column="2" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="REALISASI HASIL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding TotalActualYieldDisplay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding OverallAchievementDisplay, StringFormat='Capai: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushSuccess}"/>
                </StackPanel>
            </Border>

            <!-- Total Biaya -->
            <Border Grid.Column="4" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="TOTAL BIAYA" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding TotalCostsDisplay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,4,0,0"/>
                    <TextBlock Text="Bahan + Operasional" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- Total Pendapatan -->
            <Border Grid.Column="6" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="TOTAL PENDAPATAN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding TotalRevenuesDisplay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" Margin="0,4,0,0"/>
                    <TextBlock Text="Hasil Penjualan" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>

            <!-- Total Laba Bersih -->
            <Border Grid.Column="8" Background="{DynamicResource BrushCardBackground}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <StackPanel>
                    <TextBlock Text="TOTAL LABA BERSIH" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding TotalProfitDisplay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushPrimary}" Margin="0,4,0,0"/>
                    <TextBlock Text="Pendapatan - Biaya" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Report DataGrid & States -->
        <Border Grid.Row="3"
                Background="{DynamicResource BrushCardBackground}"
                BorderBrush="{DynamicResource BrushBorder}"
                BorderThickness="1"
                CornerRadius="8"
                ClipToBounds="True">
            <Grid>
                <!-- Loading State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,0,0,12"/>
                    <TextBlock Text="Menyusun laporan produksi dan keuangan..." 
                               Foreground="{DynamicResource BrushTextSecondary}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="Tidak ada data laporan untuk kriteria filter terpilih" 
                               FontSize="16" FontWeight="SemiBold" 
                               Foreground="{DynamicResource BrushTextPrimary}" 
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Silakan sesuaikan kriteria rentang tanggal, lahan, atau komoditas." 
                               FontSize="13" Margin="0,6,0,0"
                               Foreground="{DynamicResource BrushTextSecondary}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid ItemsSource="{Binding Reports}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserSortColumns="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          RowHeight="44"
                          SelectionMode="Single"
                          BorderThickness="0"
                          Visibility="{Binding IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <!-- Penanaman -->
                        <DataGridTemplateColumn Header="Penanaman &amp; Musim" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PlantingCode}" FontWeight="SemiBold" Foreground="{DynamicResource BrushPrimary}"/>
                                        <TextBlock Text="{Binding SeasonName}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Lahan & Komoditas -->
                        <DataGridTemplateColumn Header="Lahan &amp; Komoditas" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CommodityName}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding LandName}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Target Hasil -->
                        <DataGridTextColumn Header="Target Hasil" Binding="{Binding TargetYieldDisplay}" Width="110"/>

                        <!-- Hasil Aktual -->
                        <DataGridTextColumn Header="Hasil Panen" Binding="{Binding ActualYieldDisplay}" FontWeight="SemiBold" Width="110"/>

                        <!-- % Capai Target -->
                        <DataGridTextColumn Header="Pencapaian" Binding="{Binding TargetAchievementDisplay}" FontWeight="Bold" Width="100"/>

                        <!-- Biaya Bahan -->
                        <DataGridTextColumn Header="Biaya Bahan" Binding="{Binding TotalMaterialCostDisplay}" Width="120"/>

                        <!-- Biaya Operasional -->
                        <DataGridTextColumn Header="Biaya Operasional" Binding="{Binding TotalOperationalCostDisplay}" Width="130"/>

                        <!-- Total Biaya -->
                        <DataGridTextColumn Header="Total Biaya" Binding="{Binding TotalCostDisplay}" FontWeight="SemiBold" Width="130"/>

                        <!-- Total Pendapatan -->
                        <DataGridTextColumn Header="Pendapatan" Binding="{Binding TotalRevenueDisplay}" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" Width="130"/>

                        <!-- Laba / Rugi Bersih -->
                        <DataGridTemplateColumn Header="Laba / Rugi Bersih" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NetProfitDisplay}" 
                                               FontWeight="Bold" 
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource BrushPrimary}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
